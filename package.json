{
  "name": "n8n-nodes-zapzap",
  "version": "0.1.3",
  "description": "n8n community nodes for the ZapZap API: send WhatsApp messages, media, polls, buttons and lists, react to messages, manage instances and receive real-time events.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "whatsapp",
    "whatsapp-api",
    "whatsapp-automation",
    "zapzap",
    "zapzapapi",
    "messaging",
    "chatbot",
    "automation",
    "webhook"
  ],
  "license": "MIT",
  "homepage": "https://zapzapapi.com/?utm_source=npm&utm_medium=package&utm_campaign=n8n-node",
  "author": {
    "name": "GM Solutions Hub LTDA",
    "email": "contato@zapzapapi.com",
    "url": "https://zapzapapi.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zapzapapi/n8n-nodes-zapzap.git"
  },
  "engines": {
    "node": ">=18.10"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && gulp build:icons && gulp build:translations && gulp build:codex",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "n8n-node lint",
    "lintfix": "n8n-node lint --fix",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test --test-concurrency=1 test/action.test.js test/trigger.test.js test/hardening.test.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.pt-BR.md",
    "README.es.md",
    "CHANGELOG.md",
    "LICENSE",
    "templates"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/ZapZapApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/ZapZap/ZapZap.node.js",
      "dist/nodes/ZapZapTrigger/ZapZapTrigger.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.23.1",
    "@types/node": "^20.14.0",
    "eslint": "^9.0.0",
    "gulp": "^5.0.0",
    "n8n-workflow": "^1.60.0",
    "prettier": "^3.3.2",
    "typescript": "^5.5.3"
  },
  "bugs": {
    "url": "https://github.com/zapzapapi/n8n-nodes-zapzap/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
