{
  "name": "n8n-nodes-zapzap",
  "version": "0.1.1",
  "description": "n8n community nodes for the ZapZap API: send WhatsApp messages, media, polls, buttons and lists, react to messages, manage instances and receive real-time events.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "whatsapp",
    "whatsapp-api",
    "whatsapp-automation",
    "zapzap",
    "zapzapapi",
    "messaging",
    "chatbot",
    "automation",
    "webhook"
  ],
  "license": "MIT",
  "homepage": "https://zapzapapi.com/?utm_source=npm&utm_medium=package&utm_campaign=n8n-node",
  "author": {
    "name": "GM Solutions Hub LTDA",
    "email": "contato@zapzapapi.com",
    "url": "https://zapzapapi.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zapzapapi/n8n-nodes-zapzap.git"
  },
  "engines": {
    "node": ">=18.10"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && gulp build:icons && gulp build:translations",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/ZapZapApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/ZapZap/ZapZap.node.js",
      "dist/nodes/ZapZapTrigger/ZapZapTrigger.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/parser": "^7.15.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "gulp": "^5.0.0",
    "n8n-workflow": "^1.60.0",
    "prettier": "^3.3.2",
    "typescript": "^5.5.3"
  },
  "bugs": {
    "url": "https://github.com/zapzapapi/n8n-nodes-zapzap/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
