{
  "name": "ZapZap: alert when an instance disconnects",
  "nodes": [
    {
      "parameters": {
        "content": "Listens to connection events and warns an admin number on WhatsApp (use a different, connected instance for the alert).\nPick your instance: in the Trigger, the instance to watch; in the alert node, a different connected instance that sends the warning. Then set the admin number.",
        "width": 420,
        "height": 200
      },
      "id": "note--200",
      "name": "Note -200",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -200,
        -120
      ]
    },
    {
      "parameters": {
        "instanceId": "",
        "events": [
          "connection"
        ]
      },
      "id": "zapzap-trigger",
      "name": "ZapZap Trigger",
      "type": "n8n-nodes-zapzap.zapZapTrigger",
      "typeVersion": 1,
      "position": [
        0,
        100
      ],
      "credentials": {
        "zapZapApi": {
          "id": "",
          "name": "ZapZap API"
        }
      },
      "webhookId": "zapzap-trigger-hook"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-5",
              "leftValue": "={{ $json.data.instance.status }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "disconnected"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "is-disconnected",
      "name": "Is disconnected",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        220,
        100
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendText",
        "instanceId": "",
        "number": "5511999990001",
        "text": "=Instance {{ $json.instance_name }} disconnected. Open app.zapzapapi.com to reconnect it."
      },
      "id": "alert-admin",
      "name": "Alert admin",
      "type": "n8n-nodes-zapzap.zapZap",
      "typeVersion": 1,
      "position": [
        460,
        100
      ],
      "credentials": {
        "zapZapApi": {
          "id": "",
          "name": "ZapZap API"
        }
      }
    }
  ],
  "connections": {
    "ZapZap Trigger": {
      "main": [
        [
          {
            "node": "Is disconnected",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is disconnected": {
      "main": [
        [
          {
            "node": "Alert admin",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
